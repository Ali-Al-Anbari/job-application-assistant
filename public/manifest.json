{
  "manifest_version": 3,
  "name": "Job Application Assistant",
  "version": "0.1.0",

  "icons": {
  "16": "icons/icon16.png",
  "32": "icons/icon32.png",
  "48": "icons/icon48.png",
  "128": "icons/icon128.png"
  },

  "permissions": [
    "storage",
    "activeTab",
    "scripting",
    "identity"
  ],

  "host_permissions": [
    "https://gmail.googleapis.com/"
  ],

  "oauth2": {
    "client_id": "809421851779-seiq2ht0su7njdstp20g53444adv6gkl.apps.googleusercontent.com",
    "scopes": [
      "https://www.googleapis.com/auth/gmail.readonly"
    ]
  },

  "action": {
    "default_popup": "index.html",
    "default_icon": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png"
  }
  }
}